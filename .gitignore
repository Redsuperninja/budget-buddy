# --- Personal data: never commit ---
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.db.bak-*
*.db.lock
# Receipt photos a Home Base stores (its data folder), wherever a copy lands; not the phone app's receipts code.
receipts/
# In the phone app's code folders named receipts, only code files are allowed (never a photo, whatever its
# format or letter case).
!mobile/src/**/receipts/
mobile/src/**/receipts/**
!mobile/src/**/receipts/**/
!mobile/src/**/receipts/**/*.ts
!mobile/src/**/receipts/**/*.tsx
backups/
*.bbbackup
.env
.env.*
!.env.example

